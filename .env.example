# Vite mode: local for desktop/dev, netlify for public demo builds.
VITE_APP_MODE=local

# Optional UI defaults. Do not put secrets in VITE_* variables.
VITE_DEFAULT_CLOUD_ENDPOINT=https://openrouter.ai/api/v1
VITE_DEFAULT_LOCAL_ENDPOINT=http://localhost:1234/v1/chat/completions

# Netlify Functions allowlist for BYOK proxy endpoints.
NETLIFY_ALLOWED_ENDPOINTS=https://api.openai.com/v1,https://openrouter.ai/api/v1,https://api.groq.com/openai/v1,https://api.deepseek.com
