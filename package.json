{
  "name": "claroia",
  "private": true,
  "version": "1.1.0",
  "main": "dist-electron/main.js",
  "description": "Local-first LLM summarization and evaluation workbench",
  "author": "ClaroIA contributors",
  "license": "MIT",
  "homepage": "https://github.com/apolmig/claroia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apolmig/claroia.git"
  },
  "bugs": {
    "url": "https://github.com/apolmig/claroia/issues"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:3000 && tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\" && electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\" && vite build && electron-builder",
    "clean:release": "node -e \"require('fs').rmSync('dist-electron/release',{recursive:true,force:true})\"",
    "build:desktop:win": "npm run clean:release && set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run electron:build -- --win zip",
    "release:win": "npm run build:desktop:win",
    "test": "vitest -c vite.config.test.ts"
  },
  "dependencies": {
    "i18next": "^25.8.0",
    "lucide-react": "^0.554.0",
    "pdfjs-dist": "^5.4.449",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.8.9",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.3.4",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "vitest": "^4.0.17",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.claroia.app",
    "productName": "ClaroIA",
    "directories": {
      "output": "dist-electron/release"
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.js",
      "dist-electron/package.json",
      "!dist-electron/release{,/**/*}"
    ],
    "extraResources": [
      "LICENSE",
      "CHANGELOG.md",
      "README.md",
      "PRIVACY.md",
      "SECURITY.md",
      "docs/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "zip"
      ]
    }
  }
}
